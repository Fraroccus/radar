# Chiavi API per l'AI Radar
# In sviluppo locale: crea un file .env e incolla qui le chiavi.
# Su Vercel: inserisci queste variabili d'ambiente nella sezione "Settings" -> "Environment Variables".

# Obbligatoria per la ricerca live in tempo reale con Google Search Grounding:
GEMINI_API_KEY=

# Opzionale per l'assistente didattico (Llama 3):
GROQ_API_KEY=
